# ---------------------------------------------------------------------------
# SAT - Superagentic Trading
# Every default below points at Robinhood Chain MAINNET and works with no
# configuration at all. Only OPENAI_API_KEY is needed to switch the agent on.
# ---------------------------------------------------------------------------

# --- Agent (required for the chat panel) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Data source ---
# chain      = read Robinhood Chain mainnet directly (default)
# subgraph   = use a Uniswap v3 subgraph; requires RH_SUBGRAPH_URL
# synthetic  = offline fake market for UI development
SAT_DATA_SOURCE=chain
RH_SUBGRAPH_URL=

# --- Network (verified against docs.robinhood.com/chain/connecting) ---
# The public RPC is rate limited. For anything beyond local use, put a
# dedicated endpoint here (Alchemy, QuickNode, dRPC all support chain 4663).
RH_CHAIN_ID=4663
RH_CHAIN_NAME=Robinhood Chain
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
RH_NATIVE_SYMBOL=ETH

# --- Trading ---
# Off by default. The app is read-only until this is "true". Even when on, the
# agent can only propose: every transaction is signed in your own wallet.
SAT_ENABLE_TRADING=false
# Uniswap v3 on Robinhood Chain. Verified on-chain: SwapRouter02.factory() and
# .WETH9() both match the official deployment.
RH_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
RH_WRAPPED_NATIVE=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# --- Guardrails applied to every proposed trade ---
SAT_MAX_TRADE_NATIVE=0.05
SAT_MAX_SLIPPAGE_BPS=100
SAT_MIN_LIQUIDITY_USD=10000
